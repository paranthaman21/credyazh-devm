GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Bounded total wait for one extraction (primary + any sequential fallback).
# This is a wait cap, not a speed guarantee. Slow Gemini calls still take
# however long the model needs; we stop waiting when the budget is gone.
AI_SHARED_DEADLINE_MS=35000
# Per-attempt Gemini HTTP timeout; cannot exceed remaining shared deadline.
# NOTE: Gemini API enforces a minimum deadline of 10 s (10000 ms).
# A timeout does NOT start another Gemini model (that caused 11–21s tails).
GEMINI_REQUEST_TIMEOUT_MS=12000
# Do not start another model/provider attempt if less than this remains.
GEMINI_MIN_ATTEMPT_BUDGET_MS=10000
GEMINI_RATE_LIMIT_BACKOFF_MS=250
GEMINI_MAX_OUTPUT_TOKENS=1024

# Phase 3 — Local regex fast-path (no Gemini call for simple transcripts).
# Set to false only for debugging / testing the Gemini path directly.
ENABLE_LOCAL_EXTRACTOR=true

# Phase 2 — Multi-Provider Failover (Groq Secondary)
# Keep disabled until explicitly approved:
AI_FAILOVER_ENABLED=false
AI_PRIMARY_PROVIDER=gemini
AI_BACKUP_PROVIDER=groq
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_S=30.0
