PORT=4000

# MongoDB Atlas connection string
# Get this from https://cloud.mongodb.com → your cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/credyazh?retryWrites=true&w=majority

# AI service URL
# Docker Compose: leave as http://ai-service:8000 (compose handles routing)
# Local dev (no Docker): change to http://localhost:8000
AI_SERVICE_URL=http://ai-service:8000

# Must be > AI_SHARED_DEADLINE_MS in the Python service (default 35000)
AI_CLIENT_TIMEOUT_MS=40000
